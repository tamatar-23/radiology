# ============================================================================
# Multimodal Agentic Radiology Assistant — Environment Configuration Template
# ============================================================================

# 1. Execution Mode ("mock" runs with zero external API keys or model weights; "real" requires weights & keys)
AI_MODE=mock

# 2. Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# 3. Backend Server & CORS
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 4. Database Configuration
# Default local development uses SQLite (no external database daemon required):
DATABASE_URL=sqlite:///./radiology_dev.db
# For Docker / PostgreSQL environment, uncomment below:
# DATABASE_URL=postgresql://radiology:radiology_pass@localhost:5432/radiology_db

# 5. Local Upload Storage
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=15

# 6. Vision & Classification Configuration (Used when AI_MODE=real)
VISION_MODEL_NAME=densenet121-cxr
VISION_WEIGHTS_PATH=
CONFIDENCE_THRESHOLD=0.50

# 7. Vector Database & Embeddings Configuration (Used when AI_MODE=real)
VECTOR_DB_TYPE=chroma
CHROMA_PERSIST_DIR=data/processed/chroma_db
CHROMA_COLLECTION_NAME=chest_xray_literature
EMBEDDING_MODEL_NAME=BAAI/bge-large-en-v1.5
TOP_K_RETRIEVAL=3
CHUNKING_SIZE=500
CHUNKING_OVERLAP=50

# 8. LLM Synthesizer Configuration (Used when AI_MODE=real)
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.2
